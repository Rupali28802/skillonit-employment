# Copy to .env.local for local development. Never commit .env.local.
# Local fixture mode is single-process only. NEVER use it for real candidate data.
DEMO_MODE=false
APP_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DATABASE=skillonit
REDIS_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
