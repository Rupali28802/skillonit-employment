{
  "name": "skillonit-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "jobs:seed": "node --env-file-if-exists=.env --import tsx src/job-engine/cli.ts seed",
    "jobs:configure": "node --env-file-if-exists=.env --import tsx src/job-engine/cli.ts configure",
    "jobs:once": "node --env-file-if-exists=.env --import tsx src/job-engine/cli.ts once",
    "jobs:status": "node --env-file-if-exists=.env --import tsx src/job-engine/cli.ts status",
    "worker:jobs": "node --env-file-if-exists=.env dist/job-engine/cli.js watch",
    "test:jobs": "node --import tsx --test tests/job-engine.test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "worker": "node --env-file-if-exists=.env dist/workers/index.js",
    "worker:module2": "node --env-file-if-exists=.env dist/workers/module2.js",
    "module2:check": "node --env-file-if-exists=.env --import tsx src/module2-production-check.ts",
    "typecheck": "tsc --noEmit",
    "catalog:configure": "node --env-file-if-exists=.env --import tsx src/configure-student-catalog.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/db-check.ts",
    "cv:check": "node --env-file-if-exists=.env --import tsx src/cv-provider-check.ts",
    "test:module2": "node --import tsx --test tests/module2.test.ts tests/module2-foundation.test.ts tests/module2-hardening.test.ts tests/module2-providers.test.ts tests/module2-runtime.test.ts tests/student-profile.test.ts",
    "test:module2:mongo": "node --import tsx --test tests/module2-mongo.test.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node tests/integration.mjs",
    "test:features": "node tests/features.mjs",
    "test:mongo": "node --import tsx tests/mongo-integration.ts",
    "test:architecture": "node tests/architecture.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "bullmq": "^6.3.4",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "he": "^1.2.0",
    "ioredis": "^5.11.1",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "mongodb-memory-server": "^10.2.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "yazl": "^3.3.1"
  }
}
