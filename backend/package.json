{
  "name": "skillonit-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "matching:index": "node --env-file-if-exists=.env --import tsx src/matching-index.ts",
    "test:matching": "node --import tsx --test tests/job-matching*.test.ts tests/matching*.test.ts",
    "test:sources": "node --import tsx --test tests/job-source*.test.ts",
    "test:sources:mongo": "node --import tsx --test tests/job-source-mongo.test.ts",
    "test:discovery": "node --import tsx --test tests/job-discovery*.test.ts",
    "test:ingestion": "node --import tsx --test tests/job-ingestion*.test.ts",
    "test:fraud": "node --import tsx --test tests/fraud-detection*.test.ts",
    "test:deduplication": "node --import tsx --test tests/job-deduplication*.test.ts",
    "test:lifecycle": "node --import tsx --test tests/job-lifecycle*.test.ts",
    "test:subscriptions": "node --import tsx --test tests/student-entitlements*.test.ts",
    "test:billing": "node --import tsx --test tests/payment-billing*.test.ts",
    "test:employer": "node --import tsx --test tests/employer-portal*.test.ts",
    "test:admin": "node --import tsx --test tests/admin-console*.test.ts",
    "test:notifications": "node --import tsx --test tests/notification-platform*.test.ts",
    "test:queue": "node --import tsx --test tests/queue-infrastructure*.test.ts",
    "test:assistant": "node --import tsx --test tests/ai-assistant*.test.ts",
    "test:analytics": "node --import tsx --test tests/analytics-platform*.test.ts",
    "test:security": "node --import tsx --test tests/observability-security*.test.ts",
    "test:production": "node --import tsx --test tests/production-readiness.test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "worker": "node --env-file-if-exists=.env dist/workers/index.js",
    "worker:module2": "node --env-file-if-exists=.env dist/workers/module2.js",
    "module2:check": "node --env-file-if-exists=.env --import tsx src/module2-production-check.ts",
    "typecheck": "tsc --noEmit",
    "catalog:configure": "node --env-file-if-exists=.env --import tsx src/configure-student-catalog.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/db-check.ts",
    "cv:check": "node --env-file-if-exists=.env --import tsx src/cv-provider-check.ts",
    "test:module2": "node --import tsx --test tests/google-drive-storage.test.ts tests/module2.test.ts tests/module2-foundation.test.ts tests/module2-hardening.test.ts tests/module2-providers.test.ts tests/module2-runtime.test.ts tests/student-profile.test.ts",
    "test:module2:mongo": "node --import tsx --test tests/module2-mongo.test.ts",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:integration": "node tests/integration.mjs",
    "test:features": "node tests/features.mjs",
    "test:mongo": "node --import tsx tests/mongo-integration.ts",
    "test:architecture": "node tests/architecture.mjs",
    "test:frontend": "node --import tsx ../scripts/test-frontend-integration.mts"
  },
  "dependencies": {
    "bullmq": "^6.3.4",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "ioredis": "^5.11.1",
    "mongodb": "^7.6.0",
    "nodemailer": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "mongodb-memory-server": "^10.2.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "yazl": "^3.3.1"
  }
}
