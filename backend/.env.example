PORT=4000
HOST=127.0.0.1
# Copy to .env for local development. Never commit .env.
# Local fixture mode is single-process only. NEVER use it for real candidate data.
# DEMO_MODE=true is rejected with NODE_ENV=production, a public APP_URL,
# or a non-loopback HOST. Never expose even a loopback demo through a tunnel/proxy.
DEMO_MODE=false
APP_URL=http://localhost:3000
MONGODB_URI=
# Put the Atlas application URI only in local .env; keep credentials out of chat.
MONGODB_DATABASE=skillonit
ENABLE_AUTH_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Production auth mail requires APP_URL to be an HTTPS origin.
REDIS_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Mail OAuth, private CV storage/scanning, AI and WhatsApp are not enabled.
# Configure audited provider adapters before accepting production users.

# OTP HMAC key: generate 32 random bytes as hex; keep real value only in .env.
AUTH_OTP_SECRET=

# Google OAuth web client: backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
