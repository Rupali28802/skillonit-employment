PORT=4000
HOST=127.0.0.1
LOCAL_PREVIEW_ORIGIN=
# Copy to .env for local development. Never commit .env.
# Local fixture mode is single-process only. NEVER use it for real candidate data.
# DEMO_MODE=true is rejected with NODE_ENV=production, a public APP_URL,
# or a non-loopback HOST. Never expose even a loopback demo through a tunnel/proxy.
DEMO_MODE=false
APP_URL=http://localhost:3000
MONGODB_URI=
# Put the Atlas application URI only in local .env; keep credentials out of chat.
MONGODB_DATABASE=skillonit
ENABLE_AUTH_EMAIL=false
# Account verification OTP/recovery email delivery. SMTP_PASSWORD is a secret.
# For Gmail SMTP, use an authorized app password, never the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# Production auth mail requires APP_URL to be an HTTPS origin.
REDIS_URL=
# Shared BullMQ worker controls. Production Redis must use rediss://.
QUEUE_WORKER_CONCURRENCY=4
QUEUE_RATE_LIMIT_PER_MINUTE=60
# Enables the Application Engine scheduler and sender workers after Redis,
# MongoDB, Gmail mailbox OAuth and Module 2 CV providers are validated.
ENABLE_APPLICATION_ENGINE=false
# Platform notification dispatcher. Uses the trusted SMTP settings above for
# opt-in email notifications; user Gmail OAuth remains application-send only.
ENABLE_NOTIFICATION_PLATFORM=false
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_USER_DAILY_LIMIT=100
# Module 2 production requires rediss:// with trusted TLS certificates.
# Optional connection controls (defaults: 5000 ms and 3 reconnect attempts).
# REDIS_CONNECT_TIMEOUT_MS=
# REDIS_CONNECT_RETRIES=
# Razorpay backend credentials. Keep real values only in .env/your secret manager.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for Admin-managed Razorpay configuration. Dedicated 32-byte hex AES key;
# provision through deployment secret management and retain with encrypted backups.
PAYMENT_CONFIG_ENCRYPTION_KEY=
# Use a dedicated webhook secret for POST /api/v1/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=
# Configure and validate the relevant providers before enabling production features.

# OTP HMAC key: generate 32 random bytes as hex; keep real value only in .env.
AUTH_OTP_SECRET=

# Google OAuth web client: backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Separate Gmail send-only OAuth client. Never expose its secret to the frontend.
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
# Optional override. Default: APP_URL + /api/v1/mail/google/callback
MAIL_GOOGLE_CALLBACK_URL=
# Optional dedicated 32-byte hex key. When absent, a domain-separated key is
# derived from AUTH_OTP_SECRET so refresh tokens still remain encrypted at rest.
MAIL_TOKEN_ENCRYPTION_KEY=

# Keep disabled until private Google Drive storage, scanner and parser adapters are wired.
ENABLE_CV_UPLOADS=false

# Module 2 production adapters (configure through your secret manager; never commit .env)
CV_STORAGE_PROVIDER=google-drive
# Dedicated Google OAuth client with Drive API enabled and only the drive.file scope.
# The refresh token is produced by an offline consent grant from the storage account.
CV_GOOGLE_DRIVE_CLIENT_ID=
CV_GOOGLE_DRIVE_CLIENT_SECRET=
CV_GOOGLE_DRIVE_REFRESH_TOKEN=
# ID of a private folder created/selected using the same OAuth client.
CV_GOOGLE_DRIVE_FOLDER_ID=
CV_GOOGLE_DRIVE_ACCOUNT=skillonitemployment@gmail.com
CV_SCANNER_PROVIDER=cloudmersive
CV_SCANNER_URL=https://api.cloudmersive.com/virus/scan/file
CV_SCANNER_TOKEN=
CV_PARSER_PROVIDER=textkernel
CV_PARSER_VERSION=textkernel-v10
CV_TEXTKERNEL_ACCOUNT_ID=
CV_TEXTKERNEL_SERVICE_KEY=
CV_TEXTKERNEL_REGION=eu
# Legacy custom HTTPS parser adapter only:
CV_PARSER_URL=
CV_PARSER_TOKEN=
CV_MAX_BYTES=5242880
CV_ALLOWED_FORMATS=pdf,docx
CV_PROVIDER_TIMEOUT_MS=15000
CV_MAX_ATTEMPTS=3
CV_RETENTION_DAYS=90
CV_UPLOADS_PER_MINUTE=5
MODULE2_MUTATIONS_PER_MINUTE=60
MODULE2_LOOKUPS_PER_MINUTE=120
MODULE2_ADMIN_PER_MINUTE=10
AUTOMATION_MAX_DAILY_CAP=100

# Job Matching Engine: local retrieval works without external credentials.
# Use `aiven` for Aiven for OpenSearch. Keep `local` until the live service is validated.
MATCHING_SEARCH_PROVIDER=local
MATCHING_OPENSEARCH_URL=
# Aiven service username/password. Both are secrets and must remain in the secret manager.
MATCHING_OPENSEARCH_USERNAME=
MATCHING_OPENSEARCH_PASSWORD=
# Legacy generic OpenSearch Basic/Bearer header. Used only with provider `opensearch`.
MATCHING_OPENSEARCH_AUTHORIZATION=
MATCHING_OPENSEARCH_INDEX=skillonit-jobs-v1
MATCHING_SEMANTIC=off
# Embedding API contract. The same secret variable is used for either provider.
MATCHING_EMBEDDING_PROVIDER=openai
# Exact trusted HTTPS endpoint. Gemini endpoints are host/path validated.
# Gemini: https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent
MATCHING_EMBEDDING_URL=
# Secret API key/token. Never commit a real value.
MATCHING_EMBEDDING_TOKEN=
# Actual model, deployment revision and vector dimension. Not credentials.
# Gemini example: gemini-embedding-001, gemini-embedding-001-v1, 1536.
# Dimension must agree with the dedicated OpenSearch vector mapping.
MATCHING_EMBEDDING_MODEL=
MATCHING_EMBEDDING_VERSION=
MATCHING_EMBEDDING_DIMENSIONS=
# Candidate embedding also requires granted profile-processing consent.
MATCHING_ALLOW_CANDIDATE_EMBEDDINGS=false
MATCHING_PROVIDER_TIMEOUT_MS=5000
# Optional grounded AI Assistant provider. Without it, supported assistant
# use cases continue with deterministic database-backed answers.
AI_ASSISTANT_PROVIDER=none
AI_ASSISTANT_URL=
AI_ASSISTANT_TOKEN=
AI_ASSISTANT_MODEL=gemini-3.6-flash
AI_ASSISTANT_TIMEOUT_MS=8000
AI_ASSISTANT_PER_MINUTE=20
# Privacy-minimized backend analytics. No external analytics provider is required.
ENABLE_ANALYTICS=false
ANALYTICS_RETENTION_DAYS=395
ANALYTICS_ROLLUP_INTERVAL_MS=3600000

# Backend observability and abuse controls (no provider credential required)
TRUST_PROXY_HOPS=0
ABUSE_REQUESTS_PER_MINUTE=300
ABUSE_READS_PER_MINUTE=240
ABUSE_WEBHOOKS_PER_MINUTE=600
OBSERVABILITY_RETENTION_DAYS=90
OBSERVABILITY_QUEUE_LAG_ALERT_SECONDS=300
OBSERVABILITY_5XX_ALERT_COUNT=5
# Secret token for the internal Prometheus-compatible metrics endpoint.
OBSERVABILITY_METRICS_TOKEN=
# Retention and disaster-recovery objectives. BACKUP_ENABLED may only be set
# after managed backup and restore access have actually been validated.
ENABLE_RETENTION_MAINTENANCE=true
AUDIT_RETENTION_DAYS=365
OPERATIONAL_RETENTION_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=250
BACKUP_ENABLED=false
BACKUP_RPO_MINUTES=60
BACKUP_RTO_MINUTES=240
BACKUP_RETENTION_DAYS=35
RESTORE_DRILL_MAX_AGE_DAYS=90
SHUTDOWN_TIMEOUT_MS=15000
# Job Source Strategy. Sources remain disabled until an admin records approval evidence.
ENABLE_JOB_SOURCE_STRATEGY=false
ENABLE_JOB_DISCOVERY_ENGINE=false
JOB_SOURCE_PROVIDER_TIMEOUT_MS=10000
JOB_SOURCE_SCHEDULER_BATCH_SIZE=20
ENABLE_JOB_INGESTION_PIPELINE=false
ENABLE_JOB_VERIFICATION=false
JOB_VERIFICATION_INTERVAL_MS=300000
JOB_VERIFICATION_BATCH_SIZE=10
ENABLE_FRAUD_RECHECK=false
ENABLE_JOB_LIFECYCLE=false

# Optional job sources: configure privately only after provider approval.
# These do not enable sources automatically. Never place keys in source JSON.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
# Registered USAJOBS API email, sent as its required User-Agent.
USAJOBS_USER_AGENT=
REED_API_KEY=
# Optional token for public GitHub organization hiring-announcement searches.
# Without it, GitHub's public API rate limits apply; never expose it to the frontend.
GITHUB_TOKEN=

# Official SkillOnIT WhatsApp Business support number for public click-to-chat.
# Use international digits only: no +, spaces, brackets or hyphens. This is not an API credential.
WHATSAPP_SUPPORT_PHONE=
